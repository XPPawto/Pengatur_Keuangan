// DompetKos — skema database.
// Aturan: nominal = integer Rupiah. Timestamp = UTC. Kolom tanggal (String "YYYY-MM-DD") = tanggal kalender WIB.
// SQLite tidak punya enum/array, jadi pilihan nilai dicatat di komentar dan dijaga di src/lib/types.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Definisi amplop. kode: makan | data | paylater | kado | darurat
model Envelope {
  id             Int     @id @default(autoincrement())
  kode           String  @unique
  nama           String
  jenis          String // daily | fixed | sinking | goal | remainder
  defaultNominal Int     @default(0)
  urutanPotong   Int? // urutan dipotong saat uang kurang (1 = pertama); null = tidak pernah dipotong otomatis
  terkunci       Boolean @default(false)
  urutanTampil   Int     @default(0)

  allocations  Allocation[]
  transactions Transaction[]
  transfersOut Transfer[]    @relation("TransferFrom")
  transfersIn  Transfer[]    @relation("TransferTo")
  plans        AllocationPlan[]
  bills        Bill[]
  goals        Goal[]
}

// Satu per minggu (Minggu–Sabtu). status: menunggu | aktif | selesai
model Period {
  id             Int       @id @default(autoincrement())
  tanggalMulai   String
  tanggalSelesai String
  pemasukan      Int // uang mingguan
  tambahan       Int       @default(0) // uang lain yang masuk di tengah periode (kiriman, uang ekstra, pinjaman, piutang kembali)
  status         String
  dikonfirmasiPada DateTime?
  createdAt      DateTime  @default(now())

  allocations  Allocation[]
  transactions Transaction[]
  transfers    Transfer[]
}

model Allocation {
  id         Int      @id @default(autoincrement())
  periodId   Int
  envelopeId Int
  nominal    Int
  period     Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  envelope   Envelope @relation(fields: [envelopeId], references: [id])

  @@unique([periodId, envelopeId])
}

// Rencana pembagian per tanggal mulai periode (seed dari PRD). Dipakai untuk usulan saat `masuk`.
model AllocationPlan {
  id           Int      @id @default(autoincrement())
  tanggalMulai String
  envelopeId   Int
  nominal      Int
  envelope     Envelope @relation(fields: [envelopeId], references: [id])

  @@unique([tanggalMulai, envelopeId])
}

// jenis: keluar | koreksi. sumber: wa | web
model Transaction {
  id         Int      @id @default(autoincrement())
  periodId   Int
  envelopeId Int
  nominal    Int
  jenis      String   @default("keluar")
  catatan    String   @default("")
  sumber     String
  pesanAsli  String?
  tanggal    String // tanggal WIB transaksi
  dibuatPada DateTime @default(now())
  billId     Int? // terisi kalau transaksi ini pembayaran tagihan
  debtId     Int? // terisi kalau transaksi ini terkait hutang-piutang
  period     Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  envelope   Envelope @relation(fields: [envelopeId], references: [id])

  @@index([periodId, envelopeId])
  @@index([tanggal])
}

model Transfer {
  id           Int      @id @default(autoincrement())
  periodId     Int
  dariEnvelopeId Int
  keEnvelopeId Int
  nominal      Int
  alasan       String
  dibuatPada   DateTime @default(now())
  period       Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  dari         Envelope @relation("TransferFrom", fields: [dariEnvelopeId], references: [id])
  ke           Envelope @relation("TransferTo", fields: [keEnvelopeId], references: [id])
}

// status: belum | lunas
model Bill {
  id           Int       @id @default(autoincrement())
  nama         String
  nominal      Int
  jatuhTempo   String
  tanggalPasti Boolean   @default(true)
  envelopeId   Int?
  status       String    @default("belum")
  dibayarPada  DateTime?
  catatan      String    @default("")
  envelope     Envelope? @relation(fields: [envelopeId], references: [id])
}

model Goal {
  id          Int      @id @default(autoincrement())
  nama        String
  targetMin   Int
  targetIdeal Int
  tenggat     String
  envelopeId  Int
  envelope    Envelope @relation(fields: [envelopeId], references: [id])
}

// Daftar belanja + kamus parser. kataKunci = JSON array string.
model ShoppingItem {
  id          Int     @id @default(autoincrement())
  nama        String
  jumlah      Float
  satuan      String
  hargaSatuan Int
  kataKunci   String  @default("[]")
  envelopeKode String @default("makan")
  aktif       Boolean @default(true)
  urutan      Int     @default(0)
}

// Mode tahan belanja. hasil: menunggu | beli | batal
model HoldRequest {
  id             Int       @id @default(autoincrement())
  barang         String
  nominal        Int
  envelopeKode   String    @default("darurat")
  nomor          String? // nomor WA yang minta (null = dari website)
  dibuatPada     DateTime  @default(now())
  tanyaUlangPada DateTime
  sudahDitanya   Boolean   @default(false)
  hasil          String    @default("menunggu")
  diputuskanPada DateTime?
}

model DailyLog {
  tanggal      String  @id
  adaCatatan   Boolean @default(false)
  tanpaJajan   Boolean @default(false)
  jatahHariItu Int     @default(0)
  totalMakan   Int     @default(0)
}

// Pengingat terjadwal. jenis: uang_masuk | pagi | malam | tagihan | rekap | laporan_keluarga
model ReminderSetting {
  jenis String  @id
  jam   String // "HH:MM" WIB
  aktif Boolean @default(true)
}

// arah: masuk | keluar
model MessageLog {
  id       Int      @id @default(autoincrement())
  arah     String
  nomor    String
  isi      String
  proaktif Boolean  @default(false)
  waktu    DateTime @default(now())

  @@index([nomor, waktu])
}

// Nomor yang boleh berinteraksi dengan bot. peran: pemilik (catat & kelola) | keluarga (hanya terima laporan)
model AllowedNumber {
  id                   Int     @id @default(autoincrement())
  nomor                String  @unique
  label                String
  peran                String  @default("pemilik")
  terimaPengingat      Boolean @default(true)
  terimaLaporan        Boolean @default(true)
  terimaKonfirmasiUang Boolean @default(false)
  aktif                Boolean @default(true)
}

// Antrean pesan keluar yang tidak diminta (pengingat, laporan, OTP). Dikirim oleh bot worker
// dengan aturan jam tenang 22.00–06.00 dan maksimal 1 pesan per jam per nomor.
// status: antri | terkirim | batal | gagal
model Outbox {
  id           Int       @id @default(autoincrement())
  nomor        String
  jenis        String
  isi          String
  kunci        String?   @unique // mencegah pesan dobel, mis. "pagi:2026-10-05:6285..."
  dijadwalkan  DateTime
  status       String    @default("antri")
  percobaan    Int       @default(0)
  catatan      String?
  terkirimPada DateTime?
  dibuatPada   DateTime  @default(now())

  @@index([status, dijadwalkan])
}

// Pengaturan umum (key-value).
model Setting {
  kunci String @id
  nilai String
}

// Contoh menu 7 hari. hari: 0 = Minggu ... 6 = Sabtu. waktu: pagi | siang | malam
model MenuItem {
  id     Int    @id @default(autoincrement())
  hari   Int
  waktu  String
  menu   String
  urutan Int    @default(0)
}

// Lauk rotasi 4 minggu.
model LaukRotasi {
  mingguKe   Int    @id
  nama       String
  jumlah     String
  estimasi   Int
}

// Centang daftar belanja per minggu (mingguMulai = tanggal Minggu).
model ShoppingCheck {
  id          Int     @id @default(autoincrement())
  mingguMulai String
  itemId      Int
  dibeli      Boolean @default(true)

  @@unique([mingguMulai, itemId])
}

// Kode login sekali pakai yang dikirim lewat WhatsApp.
model LoginCode {
  id          Int      @id @default(autoincrement())
  kodeHash    String
  kedaluwarsa DateTime
  dipakai     Boolean  @default(false)
  dibuatPada  DateTime @default(now())
}

// Satu baris (id = 1). status: terhubung | terputus | menunggu_pairing
model WaConnection {
  id           Int       @id
  status       String    @default("terputus")
  nomorBot     String?
  qr           String? // string QR mentah dari WhatsApp (diubah jadi gambar oleh website)
  pairingCode  String?
  terhubungPada DateTime?
  terputusPada DateTime?
  alasan       String?
  workerPing   DateTime? // detak terakhir dari proses bot (untuk deteksi bot mati)
  updatedAt    DateTime  @default(now())
}

// Riwayat koneksi WhatsApp. peristiwa: terhubung | terputus | logout | pairing
model WaConnectionLog {
  id        Int      @id @default(autoincrement())
  peristiwa String
  alasan    String?
  waktu     DateTime @default(now())
}

// Perintah dari website ke bot worker. perintah: connect_qr | connect_code | logout
model WaCommand {
  id         Int       @id @default(autoincrement())
  perintah   String
  nomor      String?
  dibuatPada DateTime  @default(now())
  diprosesPada DateTime?
}

// Percakapan bertahap di WhatsApp (konfirmasi `ok`, pilih kategori, dst). jenis: masuk | batal | kategori
model PendingAction {
  id         Int      @id @default(autoincrement())
  nomor      String
  jenis      String
  payload    String
  kedaluwarsa DateTime
  dibuatPada DateTime @default(now())

  @@index([nomor])
}

// Jejak semua aksi yang mengubah data. Dipakai untuk riwayat aktivitas & undo.
// undo = JSON berisi cara membatalkan aksi ini (lihat src/lib/services/activity.ts).
model ActivityLog {
  id             Int       @id @default(autoincrement())
  waktu          DateTime  @default(now())
  oleh           String // nomor WA, "web", atau "sistem"
  sumber         String // wa | web | sistem
  aksi           String
  ringkasan      String
  data           String? // JSON detail (nilai sebelum/sesudah)
  undo           String? // JSON; null = tidak bisa dibatalkan
  dibatalkanPada DateTime?
  dibatalkanOleh String?

  @@index([waktu])
}

// Pencocokan saldo sistem dengan uang asli (dompet + e-wallet).
model Reconciliation {
  id          Int      @id @default(autoincrement())
  waktu       DateTime @default(now())
  oleh        String
  saldoSistem Int
  saldoAsli   Int
  selisih     Int // asli - sistem
  tindakan    String @default("") // dicatat | uang_ekstra | diabaikan | cocok
}

// Hutang-piutang. arah: piutang (orang lain utang ke kita) | hutang (kita utang ke orang lain)
// status: aktif | lunas
model Debt {
  id           Int           @id @default(autoincrement())
  orang        String
  arah         String
  nominal      Int
  catatan      String        @default("")
  envelopeKode String        @default("darurat")
  dibuatPada   DateTime      @default(now())
  status       String        @default("aktif")
  lunasPada    DateTime?
  payments     DebtPayment[]

  @@index([orang])
}

model DebtPayment {
  id      Int      @id @default(autoincrement())
  debtId  Int
  nominal Int
  waktu   DateTime @default(now())
  debt    Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
}

// Pemasukan di luar uang mingguan (mis. kiriman Ayah yang waktunya tidak tentu).
// bagian = JSON { kode amplop: nominal } hasil pembagian.
model ExtraIncome {
  id       Int      @id @default(autoincrement())
  periodId Int
  dari     String // "Ayah", "Lainnya", ...
  nominal  Int
  bagian   String
  catatan  String   @default("")
  oleh     String
  waktu    DateTime @default(now())

  @@index([periodId])
}

// ---------------------------------------------------------------- Asisten AI (Claude Code CLI, token langganan)

// Log setiap pemanggilan AI. fitur: chat_web | chat_wa | struk | kategori | review | cek
// status: ok | belum_login | limit | timeout | tidak_ada | sibuk | gagal
model AiCall {
  id       Int      @id @default(autoincrement())
  waktu    DateTime @default(now())
  fitur    String
  // penyedia: claude | gemini | openrouter. utama = percobaan pertama sebuah permintaan (dihitung kuota harian)
  penyedia String   @default("claude")
  utama    Boolean  @default(true)
  model    String
  status   String
  durasiMs Int      @default(0)
  // token yang dilaporkan Claude Code (masuk = input + cache)
  tokenMasuk  Int     @default(0)
  tokenKeluar Int     @default(0)
  catatan  String?

  @@index([waktu])
}

// Riwayat obrolan dengan asisten supaya percakapan nyambung. kanal: nomor WA atau "web". peran: user | asisten
model AiChat {
  id    Int      @id @default(autoincrement())
  kanal String
  peran String
  isi   String
  waktu DateTime @default(now())

  @@index([kanal, waktu])
}

// Hal-hal yang diingat asisten tentang pemilik (bisa dilihat & dihapus di website). sumber: pengguna | asisten
// Memori terkurasi asisten (ala Hermes Agent): dua jenis dengan batas karakter, dikelola lewat tambah / ganti / hapus.
// ruang: "pemilik" | "grup:<jid>" (catatan grup) | "anggota:<jid>:<nomor>" (profil anggota, hanya atas permintaannya).
// jenis: profil (tentang pengguna) | catatan (pelajaran & kebiasaan yang diamati asisten). sumber: pengguna | asisten | anggota.
model AiMemori {
  id         Int      @id @default(autoincrement())
  isi        String
  sumber     String   @default("pengguna")
  dibuatPada DateTime @default(now())
  ruang      String   @default("pemilik")
  jenis      String   @default("catatan")
  diperbarui DateTime @default(now())

  @@index([ruang, jenis])
}

// Indeks kata untuk mencari riwayat obrolan lama (AiChat) yang relevan dengan pesan baru.
model AiIngatanKata {
  id     Int    @id @default(autoincrement())
  kata   String
  chatId Int

  @@index([kata])
  @@index([chatId])
}

// Kata yang dipelajari bot → amplop (dari pilihan pengguna atau tebakan AI yang disetujui). sumber: pengguna | ai
model KataKategori {
  kata         String   @id
  envelopeKode String
  sumber       String   @default("pengguna")
  dibuatPada   DateTime @default(now())
}
