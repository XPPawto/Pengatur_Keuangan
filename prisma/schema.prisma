// DompetKos — skema database.
// Aturan: nominal = integer Rupiah. Timestamp = UTC. Kolom tanggal (String "YYYY-MM-DD") = tanggal kalender WIB.
// SQLite tidak punya enum/array, jadi pilihan nilai dicatat di komentar dan dijaga di src/lib/types.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Definisi amplop. kode: makan | data | paylater | kado | darurat
model Envelope {
  id             Int     @id @default(autoincrement())
  kode           String  @unique
  nama           String
  jenis          String // daily | fixed | sinking | goal | remainder
  defaultNominal Int     @default(0)
  urutanPotong   Int? // urutan dipotong saat uang kurang (1 = pertama); null = tidak pernah dipotong otomatis
  terkunci       Boolean @default(false)
  urutanTampil   Int     @default(0)

  allocations  Allocation[]
  transactions Transaction[]
  transfersOut Transfer[]    @relation("TransferFrom")
  transfersIn  Transfer[]    @relation("TransferTo")
  plans        AllocationPlan[]
  bills        Bill[]
  goals        Goal[]
}

// Satu per minggu (Minggu–Sabtu). status: menunggu | aktif | selesai
model Period {
  id             Int       @id @default(autoincrement())
  tanggalMulai   String
  tanggalSelesai String
  pemasukan      Int
  status         String
  dikonfirmasiPada DateTime?
  createdAt      DateTime  @default(now())

  allocations  Allocation[]
  transactions Transaction[]
  transfers    Transfer[]
}

model Allocation {
  id         Int      @id @default(autoincrement())
  periodId   Int
  envelopeId Int
  nominal    Int
  period     Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  envelope   Envelope @relation(fields: [envelopeId], references: [id])

  @@unique([periodId, envelopeId])
}

// Rencana pembagian per tanggal mulai periode (seed dari PRD). Dipakai untuk usulan saat `masuk`.
model AllocationPlan {
  id           Int      @id @default(autoincrement())
  tanggalMulai String
  envelopeId   Int
  nominal      Int
  envelope     Envelope @relation(fields: [envelopeId], references: [id])

  @@unique([tanggalMulai, envelopeId])
}

// jenis: keluar | koreksi. sumber: wa | web
model Transaction {
  id         Int      @id @default(autoincrement())
  periodId   Int
  envelopeId Int
  nominal    Int
  jenis      String   @default("keluar")
  catatan    String   @default("")
  sumber     String
  pesanAsli  String?
  tanggal    String // tanggal WIB transaksi
  dibuatPada DateTime @default(now())
  period     Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  envelope   Envelope @relation(fields: [envelopeId], references: [id])

  @@index([periodId, envelopeId])
  @@index([tanggal])
}

model Transfer {
  id           Int      @id @default(autoincrement())
  periodId     Int
  dariEnvelopeId Int
  keEnvelopeId Int
  nominal      Int
  alasan       String
  dibuatPada   DateTime @default(now())
  period       Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  dari         Envelope @relation("TransferFrom", fields: [dariEnvelopeId], references: [id])
  ke           Envelope @relation("TransferTo", fields: [keEnvelopeId], references: [id])
}

// status: belum | lunas
model Bill {
  id           Int       @id @default(autoincrement())
  nama         String
  nominal      Int
  jatuhTempo   String
  tanggalPasti Boolean   @default(true)
  envelopeId   Int?
  status       String    @default("belum")
  dibayarPada  DateTime?
  catatan      String    @default("")
  envelope     Envelope? @relation(fields: [envelopeId], references: [id])
}

model Goal {
  id          Int      @id @default(autoincrement())
  nama        String
  targetMin   Int
  targetIdeal Int
  tenggat     String
  envelopeId  Int
  envelope    Envelope @relation(fields: [envelopeId], references: [id])
}

// Daftar belanja + kamus parser. kataKunci = JSON array string.
model ShoppingItem {
  id          Int     @id @default(autoincrement())
  nama        String
  jumlah      Float
  satuan      String
  hargaSatuan Int
  kataKunci   String  @default("[]")
  envelopeKode String @default("makan")
  aktif       Boolean @default(true)
  urutan      Int     @default(0)
}

// Mode tahan belanja. hasil: menunggu | beli | batal
model HoldRequest {
  id             Int       @id @default(autoincrement())
  barang         String
  nominal        Int
  envelopeKode   String    @default("darurat")
  nomor          String? // nomor WA yang minta (null = dari website)
  dibuatPada     DateTime  @default(now())
  tanyaUlangPada DateTime
  sudahDitanya   Boolean   @default(false)
  hasil          String    @default("menunggu")
  diputuskanPada DateTime?
}

model DailyLog {
  tanggal      String  @id
  adaCatatan   Boolean @default(false)
  tanpaJajan   Boolean @default(false)
  jatahHariItu Int     @default(0)
  totalMakan   Int     @default(0)
}

// Pengingat terjadwal. jenis: uang_masuk | pagi | malam | tagihan | rekap | laporan_keluarga
model ReminderSetting {
  jenis String  @id
  jam   String // "HH:MM" WIB
  aktif Boolean @default(true)
}

// arah: masuk | keluar
model MessageLog {
  id       Int      @id @default(autoincrement())
  arah     String
  nomor    String
  isi      String
  proaktif Boolean  @default(false)
  waktu    DateTime @default(now())

  @@index([nomor, waktu])
}

// Nomor yang boleh berinteraksi dengan bot. peran: pemilik (catat & kelola) | keluarga (hanya terima laporan)
model AllowedNumber {
  id                   Int     @id @default(autoincrement())
  nomor                String  @unique
  label                String
  peran                String  @default("pemilik")
  terimaPengingat      Boolean @default(true)
  terimaLaporan        Boolean @default(true)
  terimaKonfirmasiUang Boolean @default(false)
  aktif                Boolean @default(true)
}

// Antrean pesan keluar yang tidak diminta (pengingat, laporan, OTP). Dikirim oleh bot worker
// dengan aturan jam tenang 22.00–06.00 dan maksimal 1 pesan per jam per nomor.
// status: antri | terkirim | batal | gagal
model Outbox {
  id           Int       @id @default(autoincrement())
  nomor        String
  jenis        String
  isi          String
  kunci        String?   @unique // mencegah pesan dobel, mis. "pagi:2026-10-05:6285..."
  dijadwalkan  DateTime
  status       String    @default("antri")
  percobaan    Int       @default(0)
  catatan      String?
  terkirimPada DateTime?
  dibuatPada   DateTime  @default(now())

  @@index([status, dijadwalkan])
}

// Pengaturan umum (key-value).
model Setting {
  kunci String @id
  nilai String
}

// Contoh menu 7 hari. hari: 0 = Minggu ... 6 = Sabtu. waktu: pagi | siang | malam
model MenuItem {
  id     Int    @id @default(autoincrement())
  hari   Int
  waktu  String
  menu   String
  urutan Int    @default(0)
}

// Lauk rotasi 4 minggu.
model LaukRotasi {
  mingguKe   Int    @id
  nama       String
  jumlah     String
  estimasi   Int
}

// Centang daftar belanja per minggu (mingguMulai = tanggal Minggu).
model ShoppingCheck {
  id          Int     @id @default(autoincrement())
  mingguMulai String
  itemId      Int
  dibeli      Boolean @default(true)

  @@unique([mingguMulai, itemId])
}

// Kode login sekali pakai yang dikirim lewat WhatsApp.
model LoginCode {
  id          Int      @id @default(autoincrement())
  kodeHash    String
  kedaluwarsa DateTime
  dipakai     Boolean  @default(false)
  dibuatPada  DateTime @default(now())
}

// Satu baris (id = 1). status: terhubung | terputus | menunggu_pairing
model WaConnection {
  id           Int       @id
  status       String    @default("terputus")
  nomorBot     String?
  qr           String? // string QR mentah dari WhatsApp (diubah jadi gambar oleh website)
  pairingCode  String?
  terhubungPada DateTime?
  terputusPada DateTime?
  alasan       String?
  workerPing   DateTime? // detak terakhir dari proses bot (untuk deteksi bot mati)
  updatedAt    DateTime  @default(now())
}

// Riwayat koneksi WhatsApp. peristiwa: terhubung | terputus | logout | pairing
model WaConnectionLog {
  id        Int      @id @default(autoincrement())
  peristiwa String
  alasan    String?
  waktu     DateTime @default(now())
}

// Perintah dari website ke bot worker. perintah: connect_qr | connect_code | logout
model WaCommand {
  id         Int       @id @default(autoincrement())
  perintah   String
  nomor      String?
  dibuatPada DateTime  @default(now())
  diprosesPada DateTime?
}

// Percakapan bertahap di WhatsApp (konfirmasi `ok`, pilih kategori, dst). jenis: masuk | batal | kategori
model PendingAction {
  id         Int      @id @default(autoincrement())
  nomor      String
  jenis      String
  payload    String
  kedaluwarsa DateTime
  dibuatPada DateTime @default(now())

  @@index([nomor])
}
