# Salin ke .env (atau jalankan `npm run setup` supaya dibuatkan otomatis).

# Database SQLite (relatif terhadap folder prisma/)
DATABASE_URL="file:../data/dompetkos.db"

# Nomor yang boleh ngobrol dengan bot (format internasional, pisah koma)
OWNER_WA_NUMBERS=6285163544535,628971688893

# Nomor keluarga (mis. orang tua): hanya menerima laporan mingguan & tanda terima uang, tidak bisa mencatat.
# Bisa juga ditambah/diubah dari halaman Pengaturan.
FAMILY_WA_NUMBERS=628979936381

# Login website: hash password (buat dengan `npm run set-password <password-baru>`)
APP_PASSWORD_HASH=
# Kunci penanda sesi login (acak, panjang). `npm run setup` mengisinya otomatis.
SESSION_SECRET=

# Folder sesi WhatsApp (perangkat tertaut). Jangan di-commit, jangan dibagikan.
WA_SESSION_DIR=./data/wa-session

# Folder backup otomatis (Sabtu 23.30, simpan 4 terakhir)
BACKUP_DIR=./data/backups

# Zona waktu (jangan diubah)
TZ=Asia/Jakarta

# Isi 1 kalau website diakses lewat HTTPS (mis. lewat tunnel). Biarkan kosong untuk http://localhost atau LAN.
COOKIE_SECURE=

# --- Asisten AI (opsional) ---
# Token dari `claude setup-token` (langganan Claude Pro/Max, BUKAN API key). Lebih praktis ditempel di website
# (Koneksi → Claude; disimpan terenkripsi). Kalau diisi di sini juga, yang dari website dipakai duluan.
CLAUDE_CODE_OAUTH_TOKEN=
# Lokasi perintah `claude` kalau tidak ada di PATH
CLAUDE_BIN=
# Folder konfigurasi Claude Code khusus bot (terpisah dari ~/.claude milik siapa pun di server)
AI_CONFIG_DIR=./data/claude-config

# Alamat yang didengarkan website. 0.0.0.0 = bisa dibuka dari HP di jaringan yang sama.
# Di server bersama / kalau pakai tunnel (Cloudflare Tunnel, Tailscale), isi 127.0.0.1 supaya hanya lewat tunnel.
WEB_HOST=0.0.0.0

